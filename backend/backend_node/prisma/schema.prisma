// backend_node/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  // 1. Enable extensions for pgvector support
  previewFeatures = ["postgresqlExtensions"] 
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  // 2. Enable the pgvector extension in the database
  extensions = [vector] 
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  name      String?
  // Guest accounts (see POST /api/auth/guest) let a reviewer try the app
  // without registering. expiresAt drives cleanupExpiredGuests, which
  // deletes them (and, via cascade below, their cart/orders) ~24h later.
  isGuest   Boolean   @default(false)
  expiresAt DateTime?
  orders    Order[]
  cart      Cart?
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  price       Decimal
  stock       Int
  category    String
  imageUrl    String?

  // 3. This was missing! It holds the text for the AI to read.
  description String?

  // 4. This stores the AI "Coordinates" (384 numbers).
  //    "Unsupported" means Prisma doesn't touch it; we use Raw SQL.
  descriptionVector Unsupported("vector(384)")?

  items       OrderItem[]
  cartItems   CartItem[]
}

// The shopping cart. One per user, separate from Order so an unpaid cart
// can never be mistaken for a placed order (see MegaMart audit BUG-13).
model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  createdAt DateTime @default(now())

  @@unique([cartId, productId])
}

model Order {
  id          Int         @id @default(autoincrement())
  createdAt   DateTime    @default(now())
  status      String      @default("COMPLETED")
  totalAmount Decimal
  userId      Int
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       OrderItem[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  quantity  Int
  price     Decimal
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
}

// Lets POST /api/checkout be safely retried (e.g. after a flaky network
// response) without double-charging stock or creating a duplicate order.
model IdempotencyKey {
  key       String   @id
  userId    Int
  orderId   Int
  response  Json
  createdAt DateTime @default(now())
}